#!/usr/bin/env bash
set -euo pipefail

project_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  printf 'check-workflow-leak: run this command from inside a Git repository\n' >&2
  exit 1
}

cd "$project_root"
failures=0

forbidden_ai_paths=(
  ".ai/workflows"
  ".ai/policies"
  ".ai/contracts"
  ".ai/templates"
  ".ai/instructions"
  ".ai/quality"
  ".ai/onboarding"
  ".ai/automation"
)

for path in "${forbidden_ai_paths[@]}"; do
  if [[ -e "$path" ]]; then
    printf 'LEAK: forbidden reusable workflow path exists: %s\n' "$path" >&2
    failures=$((failures + 1))
  fi
done

if git ls-files --error-unmatch .ai/local.yml >/dev/null 2>&1; then
  printf 'LEAK: .ai/local.yml is tracked but must remain local-only\n' >&2
  failures=$((failures + 1))
fi

while IFS= read -r path; do
  target="$(readlink "$path" || true)"
  if [[ "$target" == *"ai-project-template"* ]]; then
    printf 'LEAK: symlink points toward private workflow: %s -> %s\n' "$path" "$target" >&2
    failures=$((failures + 1))
  fi
done < <(find . -type l -not -path './.git/*' -print)

if [[ "$failures" -gt 0 ]]; then
  printf 'Workflow leak check failed: %d issue(s) found.\n' "$failures" >&2
  exit 1
fi

printf 'Workflow leak check passed.\n'
